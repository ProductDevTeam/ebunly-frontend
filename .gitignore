# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# figma replication screenshots (shoot.mjs fallback output dir)
/.screenshots/

# designer's Figma exports — local only; design/STATUS.md tracks them and IS committed
/design/screenshots/*
!/design/screenshots/.gitkeep

# next.js
/.next/
/out/
/CLAUDE.md
# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# dev tools (local only)
/app/dev/
/categories.js
/products.js
apiFilteringDocs.md
README.md
# ...but the bare pattern above matches at any depth, so re-include this one:
!design/README.md
.claude/commands/figma.md
.claude/skills/figma-replicate/SKILL.md
.gitignore
.gitignore
